# Database PostgreSQL Connection URL
DATABASE_URL="postgresql://user:password@localhost:5432/urbanpulse?sslmode=disable"

# Server Port & Client URL
PORT=5000
CLIENT_URL="http://localhost:5173"

# JWT Secrets (optional in development, required in production)
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"

# Resend API Key (optional for real emails)
RESEND_API_KEY=""
RESEND_FROM="UrbanAlert <onboarding@resend.dev>"

# Duplicate detection settings
DUPLICATE_RADIUS_M=30
DUPLICATE_WINDOW_DAYS=14
# ---------------- AI: verificarea fotografiilor (vision) ----------------
# Merge GRATUIT: pune doar UNA dintre chei. Fără nicio cheie, verificarea este SKIPPED
# și platforma funcționează normal.
#
# 1) Google Gemini (recomandat, gratuit, fără card): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
# 2) Groq (gratuit): https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
# 3) OpenRouter (modele ":free"): https://openrouter.ai/keys
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemma-3-27b-it:free"
# 4) Anthropic Claude (plătit)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Opțional: forțează providerul (gemini|groq|openrouter|anthropic). Implicit: primul cu cheie,
# iar dacă acesta eșuează (ex. limită gratuită depășită) se încearcă următorul configurat.
AI_PROVIDER=""
AI_VERIFICATION_ENABLED=true
# true = dacă AI-ul nu e configurat / pică, sesizarea NU se acceptă nemoderată (răspuns 503).
# Lasă false cât timp dezvolți fără cheie.
AI_REQUIRED=false
AI_REJECT_CONFIDENCE=0.85
AI_TIMEOUT_MS=25000
