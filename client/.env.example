# URL-ul API-ului în producție (inclusiv sufixul /api). Lasă gol în dev: Vite face proxy pe /api.
# Exemplu: VITE_API_URL=https://api.exemplu.md/api
VITE_API_URL=

# Setează la true când serverul are Google OAuth configurat.
# Dacă este false sau lipsește, butonul „Continuă cu Google” este dezactivat.
VITE_GOOGLE_AUTH_ENABLED=false
